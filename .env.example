# Local development only. Use a secret manager in staging/production.
BVMK_DATABASE_URL=jdbc:postgresql://localhost:5432/bvmk
BVMK_DATABASE_USERNAME=bvmk
BVMK_DATABASE_PASSWORD=bvmk_local_only
BVMK_REDIS_HOST=localhost
BVMK_REDIS_PORT=6379
BVMK_REDIS_PASSWORD=
BVMK_DB_POOL_SIZE=10

# Frontend
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Never commit real keys. Set these only in deployment secrets.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=
